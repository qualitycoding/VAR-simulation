# ^ assigned by Zenodo when the release is archived. Do not reuse
#   10.5281/zenodo.20395773, which belongs to the superseded draft.
references:
  - type: thesis
    title: >-
      Numerical Grid Generation And Its Application In The Solution
      Of A Model Of The Vacuum-Arc Remelting (VAR) Process
    authors:
      - family-names: Polton
        given-names: Richard
    institution:
      name: University of Southampton
    department: Faculty of Mathematical Studies
